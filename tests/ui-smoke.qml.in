import QtQuick
import Quickshell
import Quickshell.Io
import qs.Commons
import @PLUGIN_URL@ as Scarlett
ShellRoot {
    id: test
    function check(condition, message) { if (!condition) throw new Error(message) }
    function find(object, name, seen) {
        if (!object || seen.indexOf(object) >= 0) return null
        seen.push(object)
        if (object.objectName === name) return object
        for (const key of ["data", "children"]) {
            const list = object[key]
            if (!list || !list.length) continue
            for (let i = 0; i < list.length; i++) {
                const found = find(list[i], name, seen)
                if (found) return found
            }
        }
        return object.contentItem ? find(object.contentItem, name, seen) : null
    }
    function item(name) { const value = find(plugin, name, []); check(value, "Missing " + name); return value }
    function capture(name) {
        const directory = Quickshell.env("SCARLETT_CAPTURE_DIR")
        if (!directory || Quickshell.env("SCARLETT_TEST_MISSING") === "1") return
        let card = item("panelContent")
        while (card && card.borderSpec === undefined) card = card.parent
        check(card, "Cannot locate panel frame for capture")
        card.grabToImage(function(result) {
            if (!result.saveToFile(directory + "/" + name + ".png"))
                console.error("SCARLETT_UI_FAIL: capture could not be saved")
        })
    }
    PanelWindow {
        id: window
        anchors { top: true; right: true }
        implicitWidth: 60
        implicitHeight: 32
        color: Color.background
        exclusionMode: ExclusionMode.Ignore
        QtObject {
            id: mockBar
            property string position: "top"
            property bool vertical: position === "left" || position === "right"
            property int barSize: 32
            property color barForeground: Color.foreground
            property color urgent: Color.urgent
            property string fontFamily: Style.font.family
            property bool foregroundAnimationEnabled: false
            property var activePopout: null
            property var clickTargets: []
            function requestPopout(x) { activePopout = x }
            function releasePopout(x) { activePopout = null }
            function showTooltip(x, text) {}
            function hideTooltip(x) {}
        }
        Scarlett.Panel {
            id: plugin
            anchors.centerIn: parent
            bar: mockBar
            preview: true
            helperPath: @HELPER_PATH@
            manageIpc: false
        }
        Timer { id: openSettings; interval: 200; onTriggered: test.item("settingsButton").clicked() }
        Timer {
            id: lightTheme
            interval: 200
            onTriggered: {
                Color.loadColors('foreground="#202020"\nbackground="#f5f5f5"\naccent="#3659b8"')
                Color.loadShell("[popups]\nbackground = #f5f5f5\n")
                Style.spacingScale = 1.5
            }
        }
        Timer {
            property int phase: 0
            interval: 650
            repeat: true
            running: true
            onTriggered: {
                try {
                    phase++
                    if (phase === 1) plugin.open()
                    else if (phase === 2) {
                        test.check(test.item("quickInputOne").visible, "Quick controls not visible")
                        test.capture("quick-controls")
                        openSettings.start()
                    } else if (phase === 3) {
                        test.check(!test.item("quickInputOne").visible, "Settings still expands main controls")
                        test.check(test.item("settingsBack").visible, "Back missing")
                        test.check(test.item("settingsBack").activeFocus, "Back did not receive keyboard focus")
                        test.capture("device-settings")
                        lightTheme.start()
                    } else if (phase === 4) {
                        test.check(String(Color.foreground) === "#202020", "Light palette did not update")
                        test.check(test.item("panelContent").width > 0, "Panel collapsed")
                        test.item("settingsBack").clicked()
                    } else if (phase === 5) {
                        test.check(test.item("quickInputOne").visible, "Back did not restore quick controls")
                        test.check(test.item("settingsButton").activeFocus, "Back did not restore keyboard focus")
                        mockBar.position = "right"
                        plugin.deviceSettingsOpen = true
                    } else if (phase === 6) {
                        test.check(test.item("scarlettPopup").barPos === "right", "Vertical bar not reflected")
                        if (Quickshell.env("SCARLETT_TEST_MISSING") === "1")
                            test.check(!plugin.state.connected && plugin.error.length > 0, "Missing helper has no feedback")
                        plugin.close()
                        test.check(!plugin.deviceSettingsOpen, "Close did not reset navigation")
                        plugin.open()
                    } else if (phase === 7) {
                        test.check(test.item("quickInputOne").visible, "Reopen did not show quick controls")
                        if (Quickshell.env("SCARLETT_TEST_MISSING") === "1") {
                            plugin.helperPath = @REAL_HELPER_PATH@
                            plugin.close()
                            plugin.open()
                        } else {
                            console.log("SCARLETT_UI_PASS")
                            Qt.quit()
                        }
                    } else if (phase === 9) {
                        test.check(plugin.receivedState && plugin.error === "", "Helper recovery failed")
                        console.log("SCARLETT_UI_PASS")
                        Qt.quit()
                    }
                } catch (e) {
                    console.error("SCARLETT_UI_FAIL: " + e)
                    Qt.quit()
                }
            }
        }
    }
}
